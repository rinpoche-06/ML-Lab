# Required imports
from sklearn.datasets import load_breast_cancer
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import accuracy_score
# --------------------------------------------------
# 1. Load Breast Cancer Wisconsin Dataset
# --------------------------------------------------

data = load_breast_cancer()

X = data.data
y = data.target

# Split data into training and testing sets
X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.30,
    random_state=42,
    stratify=y
)

import numpy
import sklearn

print("NumPy:", numpy.__version__)
print("scikit-learn:", sklearn.__version__)
# --------------------------------------------------
# 2. Standardize the features
# --------------------------------------------------

scaler = StandardScaler()

X_train = scaler.fit_transform(X_train)
X_test = scaler.transform(X_test)

# --------------------------------------------------
# 3. MLE - No Regularization
# --------------------------------------------------

mle_model = LogisticRegression(
    C=float('inf'),
    solver='lbfgs',
    max_iter=5000
)

mle_model.fit(X_train, y_train)

# --------------------------------------------------
# 4. MAP - L2 Regularization
# --------------------------------------------------

map_l2 = LogisticRegression(
    penalty='l2',
    C=0.1,
    solver='lbfgs',
    max_iter=5000
)

map_l2.fit(X_train, y_train)
# --------------------------------------------------
# 5. MAP - L1 Regularization
# --------------------------------------------------

map_l1 = LogisticRegression(
    penalty='l1',
    C=0.1,
    solver='liblinear',
    max_iter=5000
)

map_l1.fit(X_train, y_train)
# --------------------------------------------------
# 6. Make Predictions
# --------------------------------------------------

mle_predictions = mle_model.predict(X_test)
l2_predictions = map_l2.predict(X_test)
l1_predictions = map_l1.predict(X_test)

# --------------------------------------------------
# 7. Calculate Accuracy
# --------------------------------------------------

mle_accuracy = accuracy_score(y_test, mle_predictions)
l2_accuracy = accuracy_score(y_test, l2_predictions)
l1_accuracy = accuracy_score(y_test, l1_predictions)

print("========================================")
print("       LOGISTIC REGRESSION RESULTS")
print("========================================")

print(f"MLE Accuracy       : {mle_accuracy:.4f}")
print(f"MAP (L2) Accuracy  : {l2_accuracy:.4f}")
print(f"MAP (L1) Accuracy  : {l1_accuracy:.4f}")

# --------------------------------------------------
# 8. Compare Coefficients
# --------------------------------------------------

print("\n========================================")
print("        COEFFICIENT COMPARISON")
print("========================================")

print("\nNumber of features:", len(data.feature_names))

for i, feature in enumerate(data.feature_names):

    print(
        f"{feature:30s} "
        f"MLE = {mle_model.coef_[0][i]:8.4f}   "
        f"L2 = {map_l2.coef_[0][i]:8.4f}   "
        f"L1 = {map_l1.coef_[0][i]:8.4f}"
    )
# --------------------------------------------------
# 9. Count coefficients close to zero
# --------------------------------------------------

mle_zero = sum(abs(mle_model.coef_[0]) < 0.01)
l2_zero = sum(abs(map_l2.coef_[0]) < 0.01)
l1_zero = sum(abs(map_l1.coef_[0]) < 0.01)

print("\n========================================")
print("       REGULARIZATION EFFECT")
print("========================================")

print("MLE coefficients near zero :", mle_zero)
print("L2 coefficients near zero  :", l2_zero)
print("L1 coefficients near zero  :", l1_zero)

